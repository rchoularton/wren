# =============================================================================
# Secrets — copy to `.env` and fill in only what you use. NEVER commit `.env`.
# =============================================================================
# The Core kit needs NONE of these. Fill in only the ones for integrations you
# enable in research-config.yml. Values here are referenced from
# .mcp.json (as ${VAR}) and by scripts — the raw keys never appear anywhere
# that gets committed.

# --- Anthropic (only if a script calls the API directly; Claude Code itself
#     does not read this) ---------------------------------------------------
# ANTHROPIC_API_KEY=

# --- Zotero (references.provider: zotero) ----------------------------------
# Get these at https://www.zotero.org/settings/keys
# ZOTERO_API_KEY=
# ZOTERO_LIBRARY_ID=

# --- Directus (database.backend: directus-local or managed) ----------------
# DIRECTUS_URL=http://localhost:8055
# DIRECTUS_TOKEN=
# For the local Docker instance (data/docker-compose.directus.yml):
# DIRECTUS_SECRET=set-a-long-random-string
# DIRECTUS_KEY=set-a-second-random-string
# DIRECTUS_ADMIN_EMAIL=you@example.com
# DIRECTUS_ADMIN_PASSWORD=set-a-strong-password

# --- Mendeley (future module; not wired in v1) -----------------------------
# MENDELEY_CLIENT_ID=
# MENDELEY_CLIENT_SECRET=
